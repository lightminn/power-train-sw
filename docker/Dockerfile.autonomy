FROM dustynv/l4t-pytorch:r36.4.0

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace \
    AUTONOMY_ENABLED=false

# NumPy, CUDA, and PyTorch come from the existing Jetson L4T base.
# NumPy was selected for Jetson on 2026-07-19; JAX remains an experimental x86 kernel.
# PyYAML (commissioning YAML) and pytest (in-image Verify) are not in the
# base. The dustynv base pins pip to a dead jetson mirror, so point at
# standard PyPI explicitly.
RUN pip3 install --no-cache-dir --index-url https://pypi.org/simple pytest pyyaml

WORKDIR /workspace
# WP6-B terrain core는 production 바퀴 기하를 chassis.kinematics 에서 읽는다.
# chassis 서브패키지는 stdlib 전용(순수 계산)이라 이미지 무게에 영향 없음.
COPY motor_control/chassis /workspace/chassis
COPY powertrain_autonomy /workspace/powertrain_autonomy
COPY scripts/l515_commissioning.py /workspace/scripts/l515_commissioning.py
COPY ros2/src/powertrain_ros/config/l515_terrain.yaml \
    /workspace/ros2/src/powertrain_ros/config/l515_terrain.yaml

# The controller core and ROS adapter exist, but this standalone deployment is not wired.
# Keep the image non-publishing until a separately qualified entrypoint is connected.
CMD ["bash", "-lc", "echo 'autonomy deployment idle; no /autonomy/cmd_vel publisher'; exec sleep infinity"]
