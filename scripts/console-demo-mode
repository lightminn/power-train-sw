#!/usr/bin/env python3
"""Demo mode switch for the laptop console (docs/specs/2026-11-06-demo-mode.md §1).

    scripts/console-demo-mode on|off|status [--config PATH]... [--robot HOST] [--force]

Sets ``"demo_mode"`` in the console config(s). Without --config every existing
~/.config/powertrain/operator.json and operator-demo.json is changed. Other keys
and the file mode are kept; a config that is not a JSON object stops the switch
before any file is written. --robot HOST also runs ``scripts/demo-mode`` on the
Jetson checkout over ssh (on: robot first, off: console first). Restart the
console afterwards; a running console keeps its old setting.
"""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

DEFAULT_NAMES = ("operator.json", "operator-demo.json")
ROBOT_REPO = "~/power-train-sw-integrated"
_HOST = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.-]*$")
_USER = re.compile(r"^[a-z_][a-z0-9_-]*$")


def _configs(explicit):
    if explicit:
        return [Path(p).expanduser() for p in explicit]
    base = Path.home() / ".config" / "powertrain"
    found = [base / name for name in DEFAULT_NAMES if (base / name).is_file()]
    if not found:
        raise SystemExit("console-demo-mode FAIL: 콘솔 설정이 없습니다: %s" % base)
    return found


def _load(path):
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise SystemExit("console-demo-mode FAIL: %s 를 읽지 못했습니다: %s" % (path, exc))
    if not isinstance(data, dict):
        raise SystemExit("console-demo-mode FAIL: %s 는 JSON 객체가 아닙니다" % path)
    return data


def _write(path, data):
    mode = path.stat().st_mode & 0o777
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".%s." % path.name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(data, stream, ensure_ascii=False, indent=2)
            stream.write("\n")
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def _console(action, loaded):
    for path, data in loaded:
        if action != "status":
            data["demo_mode"] = action == "on"
            _write(path, data)
        print("%s: demo_mode=%s" % (path, "true" if data.get("demo_mode") is True else "false"))


def _robot(action, host, user, force):
    command = "cd %s && scripts/demo-mode %s%s" % (ROBOT_REPO, action, " --force" if force else "")
    result = subprocess.run(["ssh", "-o", "ConnectTimeout=6", "%s@%s" % (user, host), command])
    if result.returncode != 0:
        raise SystemExit("console-demo-mode FAIL: 로봇 쪽 전환 실패(exit %d)" % result.returncode)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("action", choices=("on", "off", "status"))
    parser.add_argument("--config", action="append", default=[])
    parser.add_argument("--robot", metavar="HOST")
    parser.add_argument("--robot-user", default="zetin")
    parser.add_argument("--force", action="store_true",
                        help="로봇 쪽 주행 상태 확인을 건너뜀(로봇이 멈춘 것을 눈으로 확인했을 때만)")
    args = parser.parse_args(argv)
    if args.robot is not None and not _HOST.match(args.robot):
        parser.error("--robot 은 IPv4 주소나 호스트 이름이어야 합니다")
    if not _USER.match(args.robot_user):
        parser.error("--robot-user 형식이 올바르지 않습니다")
    # Validate every config before changing anything, robot included.
    loaded = [(path, _load(path)) for path in _configs(args.config)]
    if args.robot and args.action == "on":
        _robot(args.action, args.robot, args.robot_user, args.force)
    _console(args.action, loaded)
    if args.robot and args.action != "on":
        _robot(args.action, args.robot, args.robot_user, args.force)
    if args.action != "status":
        print("콘솔을 다시 열어야 바뀐 설정이 적용됩니다.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
