#!/bin/sh
# Keep the Jetson clock monotonic across power cycles without a backed-up RTC.
# The PMIC RTC (rtc0) resets to 1970 and overrides systemd-timesyncd's restore.
stamp=/var/lib/powertrain/clock-stamp
case "$1" in
save)
    touch "$stamp" ;;
restore)
    i=0
    while [ ! -e /dev/rtc0 ] && [ "$i" -lt 30 ]; do sleep 1; i=$((i + 1)); done
    sleep 1
    saved=$(stat -c %Y "$stamp" 2>/dev/null || echo 0)
    if [ "$saved" -gt "$(date +%s)" ]; then
        date -s "@$saved" >/dev/null && echo "clock restored to $(date)"
    fi ;;
*)
    echo "usage: $0 save|restore" >&2; exit 2 ;;
esac
