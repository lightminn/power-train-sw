+        // peripheral reset below discards them, including arrivals during Stop.
+        rx_discard_count_ += HAL_CAN_GetRxFifoFillLevel(handle_, CAN_RX_FIFO0) +
+            HAL_CAN_GetRxFifoFillLevel(handle_, CAN_RX_FIFO1);
+        if (HAL_CAN_AbortTxRequest(handle_, all_mailboxes) != HAL_OK)
+            record_hal_error(HAL_CAN_GetError(handle_), false);
+        // This v3.6 board owns CAN1. Do not use HAL_CAN_DeInit: its MSP hook
+        // gates CAN1's clock before HAL writes MCR_RESET and it hides Stop errors.
+        // Only CAN IRQs are disabled here; motor control and the HAL tick keep running.
+        if (handle_->Instance != CAN1) return false;
+        HAL_NVIC_DisableIRQ(CAN1_TX_IRQn);
+        HAL_NVIC_DisableIRQ(CAN1_RX0_IRQn);
