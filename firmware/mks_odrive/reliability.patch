+bool ODriveCAN::apply_can_config(uint32_t baud, bool recovery) {
+    if (recovery) {
+        HAL_CAN_DeactivateNotification(handle_, notifications);
+        // bxCAN has three pending frames per RX FIFO. Count the stale frames;
+        // peripheral reset below discards them, including arrivals during Stop.
+        rx_discard_count_ += HAL_CAN_GetRxFifoFillLevel(handle_, CAN_RX_FIFO0) +
+            HAL_CAN_GetRxFifoFillLevel(handle_, CAN_RX_FIFO1);
+        if (HAL_CAN_AbortTxRequest(handle_, all_mailboxes) != HAL_OK)
+            record_hal_error(HAL_CAN_GetError(handle_), false);
+        // This v3.6 board owns CAN1. Do not use HAL_CAN_DeInit: its MSP hook
+        // gates CAN1's clock before HAL writes MCR_RESET and it hides Stop errors.
+        // Only CAN IRQs are disabled here; motor control and the HAL tick keep running.
+        if (handle_->Instance != CAN1) return false;
+        HAL_NVIC_DisableIRQ(CAN1_TX_IRQn);
+        HAL_NVIC_DisableIRQ(CAN1_RX0_IRQn);
+        HAL_NVIC_DisableIRQ(CAN1_RX1_IRQn);
+        HAL_NVIC_DisableIRQ(CAN1_SCE_IRQn);
+        if (handle_->State == HAL_CAN_STATE_LISTENING && HAL_CAN_Stop(handle_) != HAL_OK)
+            record_hal_error(HAL_CAN_GetError(handle_), false);
+        // Snapshot again before reset/Init can erase a newly observed error.
+        record_hal_error(HAL_CAN_GetError(handle_), false);
+        __HAL_RCC_CAN1_FORCE_RESET();
+        __DSB();
+        __HAL_RCC_CAN1_RELEASE_RESET();
+        __DSB();
+        HAL_NVIC_ClearPendingIRQ(CAN1_TX_IRQn);
+        HAL_NVIC_ClearPendingIRQ(CAN1_RX0_IRQn);
+        HAL_NVIC_ClearPendingIRQ(CAN1_RX1_IRQn);
+        HAL_NVIC_ClearPendingIRQ(CAN1_SCE_IRQn);
+        handle_->State = HAL_CAN_STATE_RESET; // Init runs the normal MSP/IRQ setup.
+    }
+    handle_->Init.Prescaler = CAN_CLK_HZ / (21 * baud);
+    if (HAL_CAN_Init(handle_) != HAL_OK) {
+        record_hal_error(HAL_CAN_GetError(handle_));
+        return false;
+    }
+    CAN_FilterTypeDef filter = {};
+    filter.FilterActivation = ENABLE;
+    filter.FilterFIFOAssignment = CAN_RX_FIFO0;
+    filter.FilterMode = CAN_FILTERMODE_IDMASK;
+    filter.FilterScale = CAN_FILTERSCALE_32BIT;
+    filter.SlaveStartFilterBank = 14;
+    if (HAL_CAN_ConfigFilter(handle_, &filter) != HAL_OK ||
+        HAL_CAN_Start(handle_) != HAL_OK ||
+        HAL_CAN_ActivateNotification(handle_, notifications) != HAL_OK) {
+        record_hal_error(HAL_CAN_GetError(handle_));
+        return false;
+    }
+    config_.baud_rate = baud; // Applied value, not merely the queued request.
+    return true;
 }
 
