<?xml version="1.0"?>
<!-- 메인 xacro: robot_arm.urdf(팔 5축 + link_051 아래 ee_description fixed base)를 include.
     robot_arm.urdf는 <robot> 태그를 가진 완성 URDF지만,
     xacro:include는 루트 태그 이름과 무관하게 자식 엘리먼트를 그대로 이 파일의 <robot>에 이어붙임.

     이전엔 여기서 xacro:arg gripper로 그리퍼 모듈(urdf/grippers/*.xacro)을 골라 wrist_to_gripper
     fixed joint로 짜맞췄으나, 서로 다른 CAD export(팔/그리퍼 각각 다른 리비전)의 좌표계를 맞추는
     시도가 반복적으로 어긋나 폐기(2026-07-15, 사용자 결정) — robot_arm.urdf 헤더 주석 참고.
     ee_description.zip에는 joint/TCP가 전혀 없다. 따라서 MoveIt joint를 만들지 않으며,
     별도 actuator는 하드웨어 사양이 주어질 때까지 fail-closed로 둔다. -->
<robot name="robot_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="end_effector_preset" default="dual_motor_gripper"/>

  <xacro:if value="${'$(arg end_effector_preset)' == 'dual_motor_gripper'}">
    <xacro:include filename="$(find robot_arm_description)/urdf/robot_arm.urdf"/>
  </xacro:if>
  <xacro:if value="${'$(arg end_effector_preset)' == 'single_motor_gripper'}">
    <xacro:include filename="$(find robot_arm_description)/urdf/robot_arm.single_motor_gripper.urdf"/>
  </xacro:if>
  <xacro:unless value="${'$(arg end_effector_preset)' in ['dual_motor_gripper', 'single_motor_gripper']}">
    <xacro:include filename="$(find robot_arm_description)/urdf/robot_arm.urdf"/>
  </xacro:unless>

</robot>
