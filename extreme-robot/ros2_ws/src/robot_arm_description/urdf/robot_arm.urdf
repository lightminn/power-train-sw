  <!-- 그리퍼는 1 DOF다. 서보 2개(id 3·4)를 항상 같은 방향·같은 값으로 돌리므로
       gripper_left_pinion_joint 하나만 구동 조인트로 두고 나머지 3개는 전부 여기에 mimic 시킨다.
       (mimic 체인을 만들지 말 것 — KDL/robot_state_publisher 가 다단 mimic 을 못 푼다.)

       부호 규약(실기 기준, 사용자 확인): CAD export 의 zero-config(랙 q=0)가 **완전히 닫힌** 상태이고,
       θ 양수로 갈수록 열린다. θ=0 -> 닫힘, θ=+1.9444(랙 가동량 35mm) -> 완전 열림.
       axis/multiplier 는 export 원본 그대로라 랙-피니언 맞물림 물리(피치반경 18mm, 모듈1·36치)와
       일치한다. 랙 리미트 [-0.035, 0] 은 원본 export 의 우측 랙 값과 동일.
       type/limit 은 2026-07-29 실기 검증 값 — zip 원본은 type="continuous"(무제한)+비대칭 슬라이더
       리미트라서, 2026-07-31 전체 재생성 시에도 이 부분만 그대로 복원함(자동 생성 스크립트가
       덮어쓰지 않도록 수동 패치). -->
  <joint name="gripper_left_pinion_joint" type="revolute">
    <origin xyz="0.0 -0.006 0.0" rpy="0 0 0" />
    <parent link="link_048" />
    <child link="link_050" />
    <axis xyz="0.0 -1.0 -0.0" />
    <limit effort="100" velocity="100" lower="0.0" upper="1.9444444444444444" />
  </joint>
  <joint name="gripper_right_pinion_joint" type="revolute">
    <origin xyz="0.0 -0.004 0.0" rpy="0 0 0" />
    <parent link="link_049" />
    <child link="link_051" />
    <axis xyz="-0.0 -1.0 -0.0" />
    <limit effort="100" velocity="100" lower="0.0" upper="1.9444444444444444" />
    <mimic joint="gripper_left_pinion_joint" multiplier="1.0" offset="0.0" />
  </joint>
  <joint name="gripper_left_rack_joint" type="prismatic">
    <origin xyz="-0.098787 -0.259411 0.161136" rpy="0 0 0" />
    <parent link="link_043" />
    <child link="link_046" />
    <axis xyz="1.0 -0.0 -0.0" />
    <limit effort="100" velocity="100" lower="-0.035" upper="0.0" />
    <mimic joint="gripper_left_pinion_joint" multiplier="-0.018" offset="0.0" />
  </joint>
  <joint name="gripper_right_rack_joint" type="prismatic">
