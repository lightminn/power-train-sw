<?xml version="1.0"?>
<!-- 새 CAD 모델의 부모-자식 충돌쌍만 제외. 기존 모델의 Default 충돌쌍은 재사용하지 않음.
     충돌행렬 및 home 자세는 MoveIt/RViz에서 재검증 필요. -->
<robot name="robot_arm">
  <group name="arm">
    <chain base_link="base_link" tip_link="link_043" />
  </group>
  <group_state name="home" group="arm">
    <joint name="arm_joint_1" value="0" />
    <joint name="arm_joint_2" value="0" />
    <joint name="arm_joint_3" value="0" />
    <joint name="arm_joint_4" value="0" />
    <joint name="arm_joint_5" value="0" />
  </group_state>
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link" />
  <disable_collisions link1="base_link" link2="arm_axis1_motor" reason="Adjacent" />
  <disable_collisions link1="arm_axis1_motor" link2="arm_link1" reason="Adjacent" />
  <disable_collisions link1="arm_link1" link2="arm_link2" reason="Adjacent" />
  <disable_collisions link1="arm_link2" link2="arm_link3" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="pinion_A" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="pinion_B" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="finger_lower" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="finger_upper" reason="Adjacent" />
  <disable_collisions link1="tool_link" link2="arm_link5" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="toolchanger_lock_rotor" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="toolchanger_ball_1" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="toolchanger_ball_2" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="toolchanger_ball_3" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="toolchanger_ball_4" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="toolchanger_ball_5" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="toolchanger_ball_6" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="toolchanger_ball_7" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="toolchanger_ball_8" reason="Adjacent" />
  <disable_collisions link1="arm_link3" link2="arm_link4" reason="Adjacent" />
  <disable_collisions link1="arm_link4" link2="tool_link" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="link_043" reason="Adjacent" />
  <disable_collisions link1="arm_link5" link2="link_051" reason="Adjacent" />
</robot>
