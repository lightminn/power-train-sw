        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="hardware" target="developer"><mxGeometry relative="1" as="geometry"/></mxCell>
