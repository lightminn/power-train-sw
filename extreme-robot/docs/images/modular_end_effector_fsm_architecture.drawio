  <diagram id="modular-end-effector-fsm" name="모듈형 엔드이펙터 FSM">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="모듈형 엔드이펙터 제어 구조" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="400" y="25" width="800" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="도구가 바뀌어도 공통 안전 체계는 유지하고, 도구별 동작만 독립 FSM으로 교체" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#4B5563;" vertex="1" parent="1">
